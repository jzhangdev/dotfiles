[includeIf "gitdir:~/Dev/github/"]
    path = ~/.config/git/personal.inc

[includeIf "gitdir:~/Dev/InfiDive/"]
    path = ~/.config/git/work.inc

[core]
    pager = delta
    ignorecase = false
    autocrlf = input
    editor = nvim

[init]
    defaultBranch = main

[credential]
    helper = osxkeychain

[push]
    autoSetupRemote = true
    default = simple

[pull]
    rebase = true

[fetch]
    prune = true

[rerere]
    enabled = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[alias]
    st = status
    br = branch
    co = checkout
    ci = commit
    last = log -1 HEAD
    lg = log --oneline --decorate --graph -20
    unstage = restore --staged

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    side-by-side = true

[merge]
    conflictStyle = zdiff3
